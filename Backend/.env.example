# ReConnect Ethiopia — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Flask secret key (generate a strong random string)
SECRET_KEY=your-secret-key-here

# JWT secret key (generate a separate strong random string)
JWT_SECRET_KEY=your-jwt-secret-key-here

# Database URL
# For local development with psycopg v3:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/reconnect_ethiopia_dev
# For Neon (production):
#   DATABASE_URL=postgresql+psycopg://user:password@ep-xxx.us-east-1.aws.neon.tech/reconnect_ethiopia?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:5432/reconnect_ethiopia_dev
